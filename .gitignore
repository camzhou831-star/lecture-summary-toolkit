# 媒体与大文件不进库(转写、compact、OCR、bundle、讲义稿都进)
/课程视频/*.mp4
/课程视频/*.mkv
/课程视频/*.mov
/课程视频/*.webm
/课程视频/*.m4a
/课程视频/*.mp3
/课程视频/*.wav
/课程视频/*.log
/画面/**/*.jpg
**/.extract_tmp/
.DS_Store
# 课程内容(转写、总结、OCR)属于学校/讲师版权,不进公开仓库
/课程视频/*
!/课程视频/.gitkeep
/画面/*
!/画面/.gitkeep
/总结/*
!/总结/.gitkeep
__pycache__/
# 已归档的网页工作台本地数据(含课程内容)
/工作台数据/
